# Copiez ce fichier en « .env » et remplissez les valeurs. Ne publiez jamais .env.

# Base Supabase : Supabase > bouton « Connect » > « Transaction pooler » (port 6543).
# Remplacez [MOT-DE-PASSE] par le mot de passe de la base (Settings > Database).
DATABASE_URL=postgresql://postgres.oamasjocrgqpbpmbetmx:[MOT-DE-PASSE]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Secret qui protège le déclencheur des relances (/api/cron/relances). Une longue chaîne aléatoire.
CRON_SECRET=

# Facultatif : clé Claude (sinon, à saisir dans Admin > Réglages > Intégrations).
ANTHROPIC_API_KEY=

# En production derrière HTTPS (cookies sécurisés).
# NODE_ENV=production
